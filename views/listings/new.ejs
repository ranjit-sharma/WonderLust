<% layout("layouts/boilerplate") %>
<div class="row mt-3 show-page">
    <div class="col-8 offset-2">
        <h3 class="show-title mb-4">Create a New Listing</h3>
        
        <div class="card show-card listing-form-card p-4">
            <form method="POST" action="/listings" novalidate class="needs-validation listing-form m-0" enctype="multipart/form-data">
                
                <div class="mb-4">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" id="title" placeholder="Add a catchy title" type="text" class="form-control" required>
                    <div class="valid-feedback">Title looks good!</div>
                    <div class="invalid-feedback">Please enter a short title</div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" id="description" class="form-control" placeholder="Describe your place" required></textarea>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>

                <div class="mb-4">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <option value="" selected disabled>Select a category</option>
                        <% categories.forEach(category => { %>
                            <option value="<%= category %>"><%= category %></option>
                        <% }) %>
                    </select>
                    <div class="invalid-feedback">Please select a category</div>
                </div>

                <div class="mb-4">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input name="listing[image]" id="image" type="file" class="form-control" required/>
                    <div class="invalid-feedback">Please upload an image</div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label for="price" class="form-label">Price per night</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text">₹</span>
                            <input name="listing[price]" id="price" placeholder="1200" type="number" class="form-control" required min="1" />
                            <div class="invalid-feedback">Please enter a valid price</div>
                        </div>
                    </div>
                    <div class="col-md-8 mt-3 mt-md-0">
                        <label for="country" class="form-label">Country</label>
                        <select name="listing[country]" id="country" class="form-select" required>
                            <option value="" selected disabled>Select a country</option>
                            <% countries.forEach(country => { %>
                                <option value="<%= country %>"><%= country %></option>
                            <% }) %>
                        </select>
                        <div class="invalid-feedback">Please select a country</div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="state" class="form-label">State / Region</label>
                        <input name="listing[state]" id="state" placeholder="Enter state or region" type="text" class="form-control">
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <label for="location" class="form-label">City</label>
                        <input name="listing[location]" id="location" placeholder="Enter city" type="text" class="form-control" required>
                        <div class="invalid-feedback">Please enter a valid city</div>
                    </div>
                </div>
                
                <div class="mt-4 d-flex gap-3">
                    <a href="/listings" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn px-4" style="background-color:#fe424d; color:#fff; border-color:#fe424d;">Add Listing</button>
                </div>
            </form>
        </div>
        <div class="mb-5 pb-5"></div>

    </div>
</div>