<% layout("layouts/boilerplate") %>

<main class="info-page">
    <section class="info-hero">
        <span class="info-icon"><i class="fa-regular fa-comment-dots"></i></span>
        <p class="info-eyebrow">Help us improve</p>
        <h1>Share your feedback</h1>
        <p>Tell us what you enjoyed, what we can improve, or what would make your WonderLust experience better.</p>
    </section>

    <form class="info-card support-form feedback-form" method="POST" action="/feedback">
        <div class="support-form-grid">
            <div>
                <label for="feedback-name" class="form-label">Your name</label>
                <input id="feedback-name" name="name" class="form-control" type="text" required>
            </div>
            <div>
                <label for="feedback-email" class="form-label">Email address</label>
                <input id="feedback-email" name="email" class="form-control" type="email" required>
            </div>
        </div>

        <div class="mt-3">
            <label for="feedback-rating" class="form-label">How was your experience?</label>
            <select id="feedback-rating" name="rating" class="form-select" required>
                <option value="" selected disabled>Choose a rating</option>
                <option value="5">Excellent</option>
                <option value="4">Good</option>
                <option value="3">Okay</option>
                <option value="2">Needs improvement</option>
                <option value="1">Poor</option>
            </select>
        </div>

        <div class="mt-3">
            <label for="feedback-message" class="form-label">Your feedback</label>
            <textarea id="feedback-message" name="message" class="form-control" rows="6"
                placeholder="Share your thoughts..." required></textarea>
        </div>

        <button class="btn info-primary-btn mt-4" type="submit">Send feedback</button>
    </form>
</main>
