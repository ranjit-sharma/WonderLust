<% layout("layouts/boilerplate") %>

<main class="info-page">
    <section class="info-hero">
        <span class="info-icon"><i class="fa-solid fa-life-ring"></i></span>
        <p class="info-eyebrow">We are here to help</p>
        <h1>Help Center</h1>
        <p>Find quick guidance for discovering stays, managing your listing, and handling reservations.</p>
    </section>

    <section class="info-grid">
        <article class="info-card info-topic">
            <i class="fa-solid fa-magnifying-glass-location"></i>
            <h2>Finding a stay</h2>
            <p>Use the destination search, categories, price range, and rating filters on Explore to narrow your options.</p>
            <a href="/listings" class="info-link">Explore listings <i class="fa-solid fa-arrow-right"></i></a>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-house"></i>
            <h2>Hosting your home</h2>
            <p>Create a listing with clear photos, accurate details, a category, location, and price so guests know what to expect.</p>
            <a href="/listings/new" class="info-link">Create a listing <i class="fa-solid fa-arrow-right"></i></a>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-calendar-check"></i>
            <h2>Bookings and cancellations</h2>
            <p>Review reservations from your profile. Booking owners can cancel eligible reservations from the confirmation or profile page.</p>
            <a href="/profile" class="info-link">View your profile <i class="fa-solid fa-arrow-right"></i></a>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-heart"></i>
            <h2>Wishlist</h2>
            <p>Save places you love with the heart icon and revisit them anytime from My Wishlist.</p>
            <a href="/wishlist" class="info-link">Open wishlist <i class="fa-solid fa-arrow-right"></i></a>
        </article>
    </section>

    <section class="info-card info-contact">
        <h2>Still need help?</h2>
        <p>Check the <a href="/questions">Q&amp;A page</a> for common answers, or sign in to manage your account and bookings.</p>
    </section>
</main>
