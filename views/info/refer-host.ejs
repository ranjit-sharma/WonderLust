<% layout("layouts/boilerplate") %>

<main class="info-page">
    <section class="info-hero">
        <span class="info-icon"><i class="fa-solid fa-user-plus"></i></span>
        <p class="info-eyebrow">Share the WonderLust experience</p>
        <h1>Refer a host</h1>
        <p>Know someone with a memorable place to share? Invite them to become part of the WonderLust hosting community.</p>
    </section>

    <section class="info-card info-story">
        <div>
            <p class="info-eyebrow">Help a great place get discovered</p>
            <h2>Every stay starts with a recommendation.</h2>
        </div>
        <p>Tell a friend, family member, or local host about WonderLust. They can create a listing, share their space, and welcome guests looking for their next memorable stay.</p>
        <a href="/listings/new" class="btn info-primary-btn">Become a host</a>
    </section>
</main>
