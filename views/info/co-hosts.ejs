<% layout("layouts/boilerplate") %>

<main class="info-page co-host-page">
    <section class="info-hero">
        <span class="info-icon"><i class="fa-solid fa-people-arrows"></i></span>
        <p class="info-eyebrow">Host with confidence</p>
        <h1>Find a co-host</h1>
        <p>Get support from someone who can help you manage your WonderLust listing and create a great guest experience.</p>
    </section>

    <section class="info-card co-host-intro">
        <div>
            <p class="info-eyebrow">A little extra support</p>
            <h2>Share the hosting journey.</h2>
        </div>
        <p>A co-host can help with guest communication, listing updates, check-in coordination, and keeping your place ready. Choose someone you trust and agree on responsibilities before sharing access.</p>
        <a href="/listings/new" class="btn info-primary-btn">Create a listing</a>
    </section>

    <section class="info-grid">
        <article class="info-card info-topic">
            <i class="fa-solid fa-comments"></i>
            <h2>Stay connected</h2>
            <p>Work together on guest questions, arrival details, and thoughtful communication.</p>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-list-check"></i>
            <h2>Divide responsibilities</h2>
            <p>Share practical tasks such as updates, preparation, and reservation support.</p>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-lock"></i>
            <h2>Choose carefully</h2>
            <p>Only work with someone you know and trust. Keep account credentials private and discuss access clearly.</p>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-circle-question"></i>
            <h2>Need guidance?</h2>
            <p>Visit the Help Center for more information about hosting and managing your listing.</p>
            <a href="/help" class="info-link">Open Help Center <i class="fa-solid fa-arrow-right"></i></a>
        </article>
    </section>
</main>
