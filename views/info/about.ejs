<% layout("layouts/boilerplate") %>

<main class="info-page">
    <section class="info-hero info-about-hero">
        <span class="info-icon"><i class="fa-regular fa-compass"></i></span>
        <p class="info-eyebrow">Find somewhere memorable</p>
        <h1>About WonderLust</h1>
        <p>A simple way to discover welcoming stays, share special places, and plan your next escape.</p>
    </section>

    <section class="info-card info-story">
        <div>
            <p class="info-eyebrow">Our idea</p>
            <h2>Travel should feel personal.</h2>
        </div>
        <p>WonderLust brings guests and hosts together through a focused, easy-to-use experience. Browse inspiring places, compare the details that matter, save favorites, and reserve a stay that feels right for you.</p>
        <p>Whether you are planning a quiet weekend, a mountain adventure, or a city escape, WonderLust helps you move from curiosity to a place worth remembering.</p>
        <a href="/listings" class="btn info-primary-btn">Start exploring</a>
    </section>

    <section class="info-grid info-values">
        <article class="info-card info-topic">
            <i class="fa-solid fa-compass"></i>
            <h2>Explore freely</h2>
            <p>Discover stays across distinctive categories and destinations.</p>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-handshake"></i>
            <h2>Host confidently</h2>
            <p>Share your space with clear tools for listings and reservations.</p>
        </article>
        <article class="info-card info-topic">
            <i class="fa-solid fa-star"></i>
            <h2>Choose thoughtfully</h2>
            <p>Use reviews, ratings, details, and maps to make informed choices.</p>
        </article>
    </section>
</main>
