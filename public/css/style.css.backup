body {
    font-family: "Plus Jakarta Sans", sans-serif !important;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #fffafa;
    color: #222;
}

.container {
    flex: 1;
    padding-top: 2rem;
    padding-bottom: 3rem;
}

/* Authentication */
.auth-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 34rem;
    padding: 3.5rem 1rem;
    background: transparent;
}

.auth-card {
    width: min(100%, 29rem);
    padding: 2.5rem;
    border: 1px solid #e1e3e8;
    border-radius: 1.1rem;
    background: #fff;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 10%);
}

.auth-heading {
    text-align: center;
    margin-bottom: 1.75rem;
}
.auth-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fe424d;
    margin-bottom: 1.2rem;
}

.auth-brand-logo i {
    font-size: 1.7rem;
}

.auth-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: #fff1f2;
    color: #fe424d;
    font-size: 1.5rem;
}

.auth-heading h1 {
    margin: 0;
    font-size: 1.65rem;
    font-weight: 700;
}

.auth-heading p {
    margin: 0.55rem 0 0;
    color: #6c757d;
    font-size: 0.9rem;
}

.auth-story {
    max-width: 22rem;
    margin: 0.8rem auto 0 !important;
    color: #8a6267 !important;
    font-size: 0.8rem !important;
    line-height: 1.55;
}

.auth-form .form-label {
    font-size: 0.9rem;
    font-weight: 600;
}

.auth-form .form-control {
    min-height: 2.8rem;
    border-radius: 0.55rem;
}

.auth-form .form-control:focus {
    border-color: #222; box-shadow: none;
}

.auth-submit {
    width: 100%;
    min-height: 2.9rem;
    margin-top: 0.35rem;
    border: 0;
    border-radius: 0.55rem;
    background: #fe424d;
    color: #fff;
    font-weight: 600;
}

.auth-submit:hover {
    background: #e63b46;
    color: #fff;
}

.auth-switch {
    margin: 1.35rem 0 0;
    color: #6c757d;
    text-align: center;
    font-size: 0.9rem;
}

.auth-switch a {
    color: #fe424d;
    font-weight: 600;
    text-decoration: none;
}

.auth-switch a:hover {
    text-decoration: underline;
}

body:not(.dark-mode) .auth-card {
    background: #ffffff;
    border-color: #e1e3e8;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 10%);
}

body:not(.dark-mode) .auth-form .form-control {
    background-color: #fff;
    border-color: #cfd3da;
    color: #222;
}

body:not(.dark-mode) .auth-form .form-control::placeholder {
    color: #8a8f98;
}

body:not(.dark-mode) .auth-form .form-control:focus {
    background-color: #fff;
    border-color: #222;
    color: #222;
    box-shadow: none;
}

body:not(.dark-mode) .auth-submit,
body:not(.dark-mode) .auth-submit:hover,
body:not(.dark-mode) .auth-submit:focus {
    background-color: #fe424d !important;
    border-color: #fe424d !important;
    color: #fff !important;
    box-shadow: none;
}

/* Navbar */
.navbar {
    min-height: 4.75rem;
    background-color: #fff;
    padding: 0.75rem 1.5rem;
    box-shadow: 0 1px 0 rgb(0 0 0 / 6%);
}

.navbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #fe424d !important;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.navbar-brand,
.navbar-brand span,
.navbar-brand .fa-compass {
    color: #fe424d !important;
}

.navbar-brand:hover {
    color: #fe424d !important;
}

.navbar-brand .fa-compass {
    color: #fe424d;
    font-size: 2rem;
}

.nav-link {
    color: #222222 !important;
    border-radius: 0.5rem;
    padding: 0.55rem 0.7rem !important;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.nav-link:hover {
    background-color: #fff1f2;
    color: #fe424d !important;
}

.primary-nav {
    margin-left: 0.75rem;
}

.theme-toggle {
    color: #222;
    border: 1px solid #222;
    border-radius: 50%;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    margin: 0.3rem 0.5rem;
}

.theme-toggle:hover {
    color: #fe424d;
    border-color: #fe424d;
}

.search-nav {
    min-width: 0;
}

.navbar .search-form {
    width: min(30rem, 100%);
    min-height: 2.8rem;
    align-items: center;
    gap: 0;
    padding: 0.2rem 0.25rem 0.2rem 1rem;
    border: 1px solid #e1e3e8;
    border-radius: 999px;
    background-color: #fff;
    box-shadow: 0 0.2rem 0.7rem rgb(35 42 52 / 10%);
}

.navbar .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    min-height: 2.3rem;
    padding: 0;
    background-color: #fe424d !important;
    border: 1px solid #fe424d !important;
    color: #fff !important;
    border-radius: 50% !important;
    font-size: 0.85rem;
    white-space: nowrap;
    flex: 0 0 auto;
}

.navbar .search-btn:hover,
.navbar .search-btn:focus {
    background-color: #e63b46 !important;
    border-color: #e63b46 !important;
    color: #fff !important;
}

.navbar .search-btn i {
    display: inline;
    margin: 0;
}

.navbar .search-inp {
    min-height: 2.3rem;
    border: 0;
    border-radius: 999px !important;
    padding: 0.35rem 0.75rem 0.35rem 0;
    font-size: 0.88rem;
    min-width: 0;
    flex: 1 1 auto;
    box-shadow: none !important;
}

.navbar .search-inp:focus {
    border: 0;
    box-shadow: none !important;
}

body.dark-mode .navbar .search-form {
    border-color: #666;
    background-color: #3a3a3c;
}

.host-menu {
    min-width: 12rem;
    padding: 0.45rem;
    border-color: #e1e3e8;
    border-radius: 0.75rem;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 12%);
}

.host-menu .dropdown-item {
    border-radius: 0.45rem;
    padding: 0.55rem 0.7rem;
}

.host-menu .dropdown-item:hover,
.host-menu .dropdown-item:focus {
    background-color: #fff1f2;
    color: #fe424d;
}

.navbar-actions {
    align-items: center;
    gap: 0.35rem;
}

.host-link {
    font-weight: 600;
    white-space: nowrap;
}

.account-profile,
.navbar-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    padding: 0;
    border: 1px solid #e1e3e8;
    border-radius: 50%;
    background: #f7f7f7;
    color: #222;
}

.account-profile:hover,
.navbar-menu-button:hover,
.account-profile:focus,
.navbar-menu-button:focus {
    border-color: #fe424d;
    background: #fff1f2;
    color: #fe424d;
}

.account-dropdown {
    width: 17.5rem;
    margin-top: 0.7rem !important;
    padding: 0.65rem;
    border: 0;
    border-radius: 1rem;
    box-shadow: 0 0.75rem 2rem rgb(35 42 52 / 16%);
}

.account-dropdown .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 2.8rem;
    padding: 0.65rem 0.8rem;
    border-radius: 0.55rem;
    color: #222;
}

.account-dropdown .dropdown-item > i {
    flex: 0 0 1.1rem;
    width: 1.1rem;
    font-size: 1rem;
    line-height: 1;
    text-align: center;
}

.menu-dropdown .dropdown-item {
    gap: 0.75rem;
    white-space: nowrap;
}

.menu-dropdown .theme-menu-toggle {
    width: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
}

.account-dropdown .dropdown-item:hover,
.account-dropdown .dropdown-item:focus {
    background: #f7f7f7;
    color: #222;
}

.account-dropdown .dropdown-divider {
    margin: 0.55rem 0.8rem;
}

.host-promo .dropdown-item {
    align-items: flex-start;
    justify-content: space-between;
}

.host-promo span {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
}

.host-promo strong {
    font-size: 0.95rem;
}

.host-promo small {
    display: block;
    max-width: 13rem;
    color: #6c757d;
    line-height: 1.35;
    white-space: normal;
    font-size: 0.8rem;
}

.host-promo > .dropdown-item > i {
    padding-top: 0.3rem;
    color: #fe424d;
    font-size: 1.4rem;
}

.menu-dropdown {
    width: 17rem;
}

.f-info-links a {
    text-decoration: none;
    color: #222222;
    padding: 0.3rem 0.55rem;
    border-radius: 0.4rem;
}

.f-info-links a:hover {
    background-color: transparent;
    color: inherit;
    cursor: pointer;
}

.f-info-support {
    grid-area: support;
    min-width: 0;
    text-align: left;
}

.f-info-support h3 {
    margin: 0 0 0.4rem;
    color: #222;
    font-size: 0.88rem;
    font-weight: 700;
}

.f-info-support-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 0.8rem;
}

.f-info-support-links a {
    color: #222;
    font-size: 0.78rem;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
}

.f-info-support-links a:hover {
    color: #fe424d;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
}

.f-info-links,
.f-info-socials,
.f-info-brand,
.f-info-tagline,
.f-info-meta {
    vertical-align: middle;
    display: flex;
    align-items: center;
    justify-content: center;
}

.f-info-center {
    grid-area: center;
    min-width: 0;
    text-align: left;
}

.f-info-center .f-info-brand,
.f-info-center .f-info-socials {
    justify-content: flex-start;
}

.f-info-center .f-info-tagline {
    justify-content: flex-start;
    text-align: left;
}

.f-info-right {
    grid-area: right;
    min-width: 0;
    text-align: left;
}

.f-info-right h3 {
    margin: 0 0 0.4rem;
    color: #222;
    font-size: 0.88rem;
    font-weight: 700;
}

.f-info-right .f-info-links {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.3rem;
}

.f-info-right .f-info-links a {
    padding: 0;
}

.f-info-socials i {
    font-size: 1.35rem;
}

.f-info-socials a {
    color: #555;
    margin: 0 0.35rem;
    transition: color 0.2s ease, transform 0.2s ease;
}

.f-info-socials a:hover {
    color: #fe424d;
    transform: translateY(-2px);
}

.f-info-brand {
    color: #555;
    font-size: 0.94rem;
    font-weight: 600;
    gap: 0.4rem;
}

.f-info-brand i {
    color: #fe424d;
    font-size: 1.35rem;
}

.f-info-tagline {
    margin: -0.2rem 0 0;
    color: #6c757d;
    font-size: 0.8rem;
    line-height: 1.25;
}

.f-info-meta {
    grid-area: meta;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
    margin-top: 0;
    color: #6c757d;
    font-size: 0.7rem;
}

.f-info-meta strong {
    color: #fe424d;
}

.f-info {
    width: 100%;
    min-height: 0;
    margin: 0 auto;
    padding: 0.9rem 2.25rem 0.65rem;
    background-color: #f7f7f7;
    border-top: 1px solid #e5e5e5;
    display: grid;
    grid-template-areas:
        "center support right"
        "meta meta meta";
    grid-template-columns: minmax(18rem, 1fr) minmax(30rem, 1.6fr) minmax(13rem, 0.8fr);
    gap: 1.4rem;
    align-items: start;
}

body.dark-mode .f-info-support {
    border-color: #444;
}

body.dark-mode .f-info-support h3,
body.dark-mode .f-info-support-links a,
body.dark-mode .f-info-right h3 {
    color: #f1f1f1;
}

body.dark-mode .f-info-support-links a:hover {
    color: #ff7880;
}

/* Cards */
.card-img-top {
    border-radius: 1rem !important;
    width: 100% !important;
    object-fit: cover !important;
}

.card-text p {
    font-weight: 400 !important;
}

.average-rating {
    color: #555;
    font-size: 0.9rem;
}

.price-unit {
    color: #6c757d;
    font-size: 0.78em;
    font-weight: 400;
}

.price-amount {
    color: #202124;
    font-size: 1.08em;
    font-weight: 700;
}

body.dark-mode .price-unit {
    color: #bdbdbd;
}

body.dark-mode .price-amount {
    color: #f1f3f5;
}

/* Wishlist */
.wishlist-page {
    padding: 2.75rem 0 4rem;
}

.wishlist-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.wishlist-eyebrow {
    margin: 0 0 0.35rem;
    color: #fe424d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.wishlist-heading h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
}

.wishlist-subtitle {
    margin: 0.55rem 0 0;
    color: #6c757d;
    font-size: 0.92rem;
}

.wishlist-explore-btn {
    flex: 0 0 auto;
    border: 1px solid #fe424d;
    border-radius: 999px;
    background: #fe424d;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.65rem 1rem;
}

.wishlist-explore-btn:hover {
    border-color: #e63b46;
    background: #e63b46;
    color: #fff;
}

.wishlist-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
}

.wishlist-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e1e3e8;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 0.35rem 1rem rgb(35 42 52 / 7%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.wishlist-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.65rem 1.35rem rgb(35 42 52 / 12%);
}

.wishlist-image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #eef0f3;
}

.wishlist-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.25s ease;
}

.wishlist-card:hover .wishlist-image {
    transform: scale(1.025);
}

.wishlist-card-body {
    padding: 1rem 1.05rem 1.1rem;
}

.wishlist-card-body h2 {
    overflow: hidden;
    margin: 0;
    color: #222;
    font-size: 1.05rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.wishlist-location {
    overflow: hidden;
    margin: 0.35rem 0 0;
    color: #6c757d;
    font-size: 0.84rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.wishlist-price {
    margin: 0.75rem 0 0.9rem;
    color: #222;
    font-size: 0.98rem;
    font-weight: 700;
}

.wishlist-price span {
    color: #6c757d;
    font-size: 0.8rem;
    font-weight: 400;
}

.wishlist-remove-btn {
    width: 100%;
    border: 1px solid #fe424d;
    border-radius: 0.55rem;
    padding: 0.55rem 0.75rem;
    background: transparent;
    color: #fe424d;
    font-size: 0.84rem;
    font-weight: 600;
}

.wishlist-remove-btn:hover,
.wishlist-remove-btn:focus {
    background: #fe424d;
    color: #fff;
}

.wishlist-remove-btn i {
    margin-right: 0.3rem;
    font-size: 0.78rem;
}

.wishlist-empty {
    max-width: 32rem;
    margin: 3rem auto 1rem;
    padding: 3rem 1.5rem;
    border: 1px solid #e1e3e8;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 0.35rem 1rem rgb(35 42 52 / 7%);
    text-align: center;
}

.wishlist-empty > i {
    margin-bottom: 1rem;
    color: #fe424d;
    font-size: 2rem;
}

.wishlist-empty h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
}

.wishlist-empty p {
    margin-bottom: 1.25rem;
    color: #6c757d;
}

body.dark-mode .wishlist-card,
body.dark-mode .wishlist-empty {
    border-color: #444;
    background: #2a2a2c;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .wishlist-card-body h2,
body.dark-mode .wishlist-price {
    color: #f1f1f1;
}

body.dark-mode .wishlist-subtitle,
body.dark-mode .wishlist-location,
body.dark-mode .wishlist-price span,
body.dark-mode .wishlist-empty p {
    color: #bdbdbd;
}

/* Public information pages */
.info-page {
    width: min(100%, 72rem);
    margin: 0 auto;
    padding: 3.5rem 1rem 4.5rem;
}

.info-hero {
    max-width: 42rem;
    margin: 0 auto 2rem;
    text-align: center;
}

.info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: #fff1f2;
    color: #fe424d;
    font-size: 1.45rem;
}

.info-eyebrow {
    margin: 0 0 0.45rem;
    color: #fe424d;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.info-hero h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
}

.info-hero > p:last-child {
    margin: 0;
    color: #6c757d;
    line-height: 1.7;
}

.info-card {
    border: 1px solid #e1e3e8;
    border-radius: 1rem;
    padding: 2rem;
    background: #fff;
    box-shadow: 0 0.35rem 1rem rgb(35 42 52 / 7%);
}

.info-card h2 {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    font-weight: 700;
}

.info-card h2:not(:first-child) {
    margin-top: 1.75rem;
}

.info-card p {
    color: #5f6670;
    line-height: 1.75;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.info-topic {
    height: 100%;
}

.info-topic > i {
    display: block;
    margin-bottom: 1rem;
    color: #fe424d;
    font-size: 1.4rem;
}

.info-topic h2 {
    margin-bottom: 0.5rem;
}

.info-topic h2:not(:first-child) {
    margin-top: 0;
}

.info-topic p {
    margin-bottom: 1.1rem;
}

.info-link {
    color: #fe424d;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
}

.info-link:hover {
    color: #e63b46;
}

.info-link i {
    margin-left: 0.25rem;
    font-size: 0.75rem;
}

.info-contact {
    margin-top: 1rem;
    text-align: center;
}

.info-contact h2 {
    margin-top: 0;
}

.info-contact p {
    margin-bottom: 0;
}

.info-contact a {
    color: #fe424d;
    font-weight: 700;
    text-decoration: none;
}

.faq-list details {
    padding: 1.15rem 0;
    border-bottom: 1px solid #e5e5e5;
}

.faq-list details:first-child {
    padding-top: 0;
}

.faq-list details:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.faq-list summary {
    cursor: pointer;
    list-style: none;
    padding-right: 1.5rem;
    color: #222;
    font-weight: 700;
    position: relative;
}

.faq-list summary::-webkit-details-marker {
    display: none;
}

.faq-list summary::after {
    position: absolute;
    right: 0;
    content: "+";
    color: #fe424d;
    font-size: 1.2rem;
}

.faq-list details[open] summary::after {
    content: "−";
}

.faq-list details p {
    margin: 0.7rem 0 0;
    max-width: 58rem;
}

.info-story {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1rem;
}

.info-story h2 {
    font-size: 1.65rem;
    line-height: 1.3;
}

.info-story h2:not(:first-child) {
    margin-top: 0;
}

.info-story p {
    margin: 0;
}

.info-primary-btn {
    grid-column: 1 / -1;
    justify-self: start;
    background: #fe424d;
    border-color: #fe424d;
    color: #fff;
    font-weight: 600;
}

.info-primary-btn:hover {
    background: #e63b46;
    border-color: #e63b46;
    color: #fff;
}

.support-detail-card {
    max-width: 52rem;
    margin: 0 auto;
}

.support-detail-section {
    padding: 0 0 1.35rem;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid #e5e5e5;
}

.support-detail-section:last-of-type {
    margin-bottom: 0;
}

.support-detail-section h2 {
    margin-top: 0;
    color: #222;
}

.support-detail-section p {
    margin-bottom: 0;
}

.support-form {
    max-width: 48rem;
    margin: 0 auto;
}

.support-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.support-form .form-label {
    color: #222;
    font-weight: 600;
}

.support-form .form-label span {
    color: #6c757d;
    font-size: 0.8rem;
    font-weight: 400;
}

.support-form .form-control {
    border-radius: 0.55rem;
    padding: 0.7rem 0.8rem;
}

.support-form .form-control:focus {
    border-color: #222; box-shadow: none;
}

.support-form .info-primary-btn {
    width: auto;
}

body.dark-mode .support-detail-section {
    border-color: #444;
}

body.dark-mode .support-detail-section h2,
body.dark-mode .support-form .form-label {
    color: #f1f1f1;
}

body.dark-mode .support-form .form-label span {
    color: #bdbdbd;
}

/* Card Effect */
.card-img-overlay {
    opacity: 0;
    pointer-events: none;
}

.card-img-overlay:hover {
    opacity: 0.2;
    background-color: #fff;
}

.add-btn {
    background-color: #fe424d !important;
    border: none !important;
}

/* Edit Page */
.edit-btn {
    background-color: #222 !important;
    border: none !important;
    color: #fff !important;
}

body.dark-mode .edit-btn {
    background-color: #fff !important;
    border: none !important;
    color: #222 !important;
}

/* Show page */
.show-img {
    height: 30vh;
}

.btns {
    display: flex;
}

.listing-owner-actions {
    justify-content: flex-end;
    align-items: center;
    width: 100%;
}

.listing-owner-actions form {
    display: flex;
}

.show-card {
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid #e1e3e8 !important;
    border-radius: 1.1rem;
    background: #fff;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 10%);
}

.show-page {
    --bs-gutter-x: 1.5rem;
    max-width: 88rem;
    margin-right: auto;
    margin-left: auto;
}

.show-main-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    align-items: start;
    gap: 1.75rem;
}

.show-map-panel {
    position: sticky;
    top: 5.5rem;
    overflow: hidden;
    border: 1px solid #e1e3e8;
    border-radius: 1.1rem;
    background: #ffffff;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 10%);
}

.show-map-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5rem;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid #edf0f2;
}

.show-map-heading h4 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
}

.show-map-heading span {
    display: block;
    margin-top: 0.2rem;
    color: #6c757d;
    font-size: 0.76rem;
}

.show-map-heading strong {
    max-width: 9rem;
    color: #48484a;
    font-size: 0.82rem;
    line-height: 1.35;
    text-align: right;
}

.show-card .show-img {
    display: block;
    width: 100%;
    height: 24rem;
    border-radius: 0.9rem !important;
}

.show-title {
    margin-bottom: 1rem;
    font-weight: 700;
}

.show-card .card-body {
    padding: 1.25rem 0.5rem 0.5rem;
}

.show-card .card-text {
    margin-bottom: 0.8rem;
}

.show-card .card-text:last-child {
    margin-bottom: 0;
}

.show-content-section {
    padding-left: 0;
    padding-right: 0;
}

.show-content-section .form-control {
    width: 100%;
}

.reviews-section {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
}

.reviews-heading {
    grid-column: 1 / -1;
    margin: 0;
}

.review-card {
    width: 100%;
    margin: 0;
    border: 1px solid #e5e5e5;
    border-radius: 0.6rem;
}

body.dark-mode .show-card {
    border-color: #444 !important;
    background: #2a2a2c;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .show-card .card-body {
    background: #2a2a2c;
}


/* only for edit section image showing */
.edit-img {
    width: 250px;
    height: auto;
    border-radius: 8px;
}


/*map*/
#map {
    height: 30rem;
    width: 100%;
    border-radius: 0;

}

.show-page > .booking-card,
.show-page > .show-content-section {
    width: calc(100% - 1.5rem);
    max-width: 88rem;
    margin-right: auto !important;
    margin-left: auto !important;
}

.map-style-control {
    margin: 0.75rem;
}

.map-style-select {
    padding: 0.45rem 0.6rem;
    border: 1px solid #d0d0d0;
    border-radius: 0.4rem;
    background-color: #fff;
    color: #222;
    font: inherit;
    cursor: pointer;
}

body.dark-mode .map-style-select {
    border-color: #666;
    background-color: #2a2a2c;
    color: #f1f1f1;
}


/* for index page */


/* ================= FILTER TOGGLER ================= */

.filter-toggler {
    display: none;
    margin: 0.75rem 0;
}

.filter-toggler-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.7rem 1.1rem;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 0.8rem;
    color: #222;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 1px 4px rgb(0 0 0 / 7%);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.filter-toggler-btn:hover {
    border-color: #fe424d;
    box-shadow: 0 2px 8px rgb(254 66 77 / 15%);
    color: #fe424d;
}

.filter-toggler-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
}

.filter-toggler-left i {
    color: #fe424d;
    font-size: 0.9rem;
}

.filter-toggler-chevron {
    font-size: 0.75rem;
    color: #888;
    transition: transform 0.25s ease;
}

.filter-toggler-btn[aria-expanded="true"] .filter-toggler-chevron {
    transform: rotate(180deg);
}

.filter-toggler-btn[aria-expanded="true"] {
    border-color: #fe424d;
    color: #fe424d;
}

/* Category filter toggle button (sliders icon in the category bar) */
.category-filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: center;
    padding: 0.5rem 0.9rem;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 0.7rem;
    color: #444;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 1px 3px rgb(0 0 0 / 8%);
    transition: all 0.2s ease;
}

.category-filter-toggle i {
    color: #fe424d;
    font-size: 0.85rem;
}

.category-filter-toggle:hover,
.category-filter-toggle:focus {
    border-color: #fe424d;
    color: #fe424d;
    background-color: #fff1f2;
    box-shadow: 0 2px 8px rgb(254 66 77 / 15%);
}

.category-filter-toggle span {
    font-size: 0.84rem;
}

/* ================= FILTERS ================= */

#filters {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    flex-wrap: nowrap;
    overflow: hidden;
    width: 100%;
}

.categories-scroll-wrapper {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.25rem;
    flex: 1 1 auto;
}

.categories-scroll-wrapper::-webkit-scrollbar {
    display: none;
}

.listing-filters {
    position: absolute;
    top: 6rem;
    right: 1.5rem;
    z-index: 10;
    width: min(22rem, calc(100% - 2rem));
    max-height: min(34rem, calc(100vh - 7rem));
    overflow-y: auto;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid #d9d9d9;
    border-radius: 0.9rem;
    background-color: #ffffff;
    box-shadow: 0 0.75rem 2rem rgb(34 34 34 / 14%);
}

.listing-filters::-webkit-scrollbar {
    width: 0.35rem;
}

.listing-filters::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: #c7cbd1;
}


.listing-form {
    margin-bottom: 3rem;
}

.listing-form .form-label {
    margin-bottom: 0.45rem;
    color: #444;
    font-weight: 600;
}

.listing-form .form-control,
.listing-form .form-select {
    min-height: 2.75rem;
    border: 1px solid #d9dde3;
    border-radius: 0.65rem;
    padding: 0.65rem 0.85rem;
}

.listing-form textarea.form-control {
    min-height: 8rem;
    resize: vertical;
}

.listing-form .form-control:focus,
.listing-form .form-select:focus {
    border-color: #222; box-shadow: none;
}

.listing-form .row {
    --bs-gutter-x: 1rem;
}

body.dark-mode .listing-form .form-label {
    color: #f1f3f5;
}

body.dark-mode .listing-form .form-control,
body.dark-mode .listing-form .form-select {
    border-color: #48484a;
    background: #323234;
    color: #f1f3f5;
}

body.dark-mode .listing-form .form-control::file-selector-button {
    background-color: #48484a !important;
    color: #f1f3f5 !important;
    border: none;
    margin-right: 1rem;
    border-radius: 0.35rem;
}

body.dark-mode .listing-form .input-group-text {
    background-color: #48484a;
    border-color: #48484a;
    color: #f1f3f5;
}

.filter-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #ededed;
    color: #222;
}

.filter-panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
}

.filter-panel-title i {
    color: #fe424d;
    font-size: 0.95rem;
}

.filter-close {
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.5rem;
    line-height: 1;
    padding: 0 0.2rem;
    border-radius: 0.35rem;
    cursor: pointer;
}

.filter-close:hover {
    background-color: #f4f4f4;
    color: #fe424d;
}

.filter-panel-section {
    margin-bottom: 1.2rem;
}

.filter-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #333;
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
}

.filter-label i {
    color: #fe424d;
    font-size: 0.78rem;
}

.filter-input {
    border-color: #e0e0e0 !important;
    border-radius: 0.6rem !important;
    background-color: #fafafa !important;
    font-size: 0.88rem;
}

.filter-input:focus {
    border-color: #222 !important; box-shadow: none !important;
    background-color: #fff !important;
}

/* Price Range Slider */
.price-range-display {
    display: flex;
    justify-content: center;
    margin-bottom: 0.9rem;
}

#price-range-label {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: #fafbfc;
    border: 1.5px solid #e0e3e8;
    border-radius: 999px;
    color: #222;
    font-size: 0.9rem;
    font-weight: 600;
}

.price-slider-wrapper {
    position: relative;
    height: 1.5rem;
    margin: 0.5rem 0.3rem;
}

.price-slider-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    background: #e5e7eb;
    border-radius: 999px;
    transform: translateY(-50%);
    pointer-events: none;
}

.price-slider-range {
    position: absolute;
    height: 100%;
    background: #fe424d;
    border-radius: 999px;
}

.price-slider {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    transform: translateY(-50%);
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    height: 1.5rem;
    outline: none;
    border: none;
}

.price-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #fe424d;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 25%);
    pointer-events: all;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.price-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 2px 8px rgb(254 66 77 / 40%);
}

.price-slider::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #fe424d;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 25%);
    pointer-events: all;
    cursor: pointer;
}

/* Actions */
.filter-panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid #ededed;
}

.filter-clear-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #555;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.filter-clear-btn:hover {
    color: #222;
}

.filter-apply-btn {
    flex: 1;
    padding: 0.6rem 1rem;
    background-color: #fe424d;
    border: none;
    border-radius: 0.6rem;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.filter-apply-btn:hover {
    background-color: #e63b46;
}



body.dark-mode .show-map-heading strong {
    color: #f1f3f5;
}

body.dark-mode .show-map-heading {
    border-bottom-color: #3b424b;
}

.booking-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
}

.booking-card-heading h4 {
    margin-bottom: 0.25rem;
}

.booking-card-heading p {
    margin: 0;
    color: #6c757d;
    font-size: 0.85rem;
}

.booking-card-heading .booking-nightly-price {
    margin: 0;
    white-space: nowrap;
}

.booking-nightly-price small {
    color: #6c757d;
    font-size: 0.75rem;
    font-weight: 400;
}

.booking-card .form-label {
    margin-bottom: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
}

.booking-card .form-control,
.booking-card .form-select {
    min-height: 2.75rem;
    border-radius: 0.65rem;
}

body.dark-mode .booking-card-heading p,
body.dark-mode .booking-nightly-price small {
    color: #adb5bd;
}

.filter-panel-actions .btn-outline-secondary:hover {
    background-color: #f4f4f4;
    color: #222;
}

.filter-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex: 0 0 auto;
    margin-left: auto;
}

.filter-controls .text-toggle {
    margin-left: 0;
}

.filter-toggle {
    border: 1px solid #222;
    border-radius: 1rem;
    padding: 0.7rem 1rem;
    white-space: nowrap;
}

.category-filter-toggle {
    align-self: center;
    padding: 0.55rem 0.7rem;
    color: inherit;
    border-color: #bdbdbd;
    background-color: #fff;
}

.category-filter-toggle:hover,
.category-filter-toggle:focus {
    color: #fe424d;
    border-color: #fe424d;
    background-color: #fff;
}

.filter-toggle i {
    margin-right: 0.35rem;
}

.category-filter-toggle i {
    margin-right: 0;
}

.filter {
    flex: 0 0 auto;
    text-align: center;
    opacity: 0.7;
    min-width: 70px;
    transition: 0.2s ease;
    color: inherit;
    text-decoration: none;
}

.filter:hover {
    opacity: 1;
    cursor: pointer;
    transform: translateY(-2px);
}

.filter.active {
    opacity: 1;
    color: #fe424d;
}

.filter i {
    font-size: 1.1rem;
}

.filter p {
    font-size: 0.85rem;
    margin: 0.35rem 0 0;
    white-space: nowrap;
}

/* ================= TAX SWITCH ================= */

.text-toggle {
    margin-left: auto;
    border: 1px solid #e0e0e0;
    border-radius: 0.7rem;
    padding: 0.5rem 0.9rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 100%;
}

.text-toggle .form-check-input {
    border-color: #fe424d;
}

.text-toggle .form-check-input:checked {
    background-color: #fe424d;
    border-color: #fe424d;
}

.text-toggle .form-check-input:focus {
    border-color: #222; box-shadow: none;
}

.tax-info {
    display: none;
}

/* ================= LISTINGS ================= */

.listing-link {
    text-decoration: none;
    color: inherit;
}

.listing-card {
    border: none !important;
    margin-bottom: 2rem;
    transition: 0.2s ease;
    position: relative;
}

.index-listing-card:hover {
    transform: translateY(-3px);
}

.index-listing-card {
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid #e1e3e8 !important;
    border-radius: 1.1rem;
    background: #fff;
    box-shadow: 0 0.5rem 1.25rem rgb(35 42 52 / 10%);
}

.index-listing-card .card-img-top {
    display: block;
    height: 13rem;
    border-radius: 0.9rem !important;
}

.listing-card.index-listing-card .card-body {
    padding: 0.85rem 0.5rem 0.2rem;
    background: transparent;
}

.listing-title-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
}

.listing-title-row .listing-card-link {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.listing-title-row .wishlist-form {
    flex: 0 0 auto;
    margin: 0;
    margin-left: auto;
}

.listing-location,
.listing-category {
    display: inline-block;
    margin-top: 0.35rem;
    color: #6c757d;
    font-size: 0.82rem;
}

.listing-category {
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: 1px solid #cfd3da;
}

body.dark-mode .index-listing-card {
    border-color: #444 !important;
    background: #2a2a2c;
}

body.dark-mode .show-map-panel {
    border-color: #444;
    background: #2a2a2c;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .show-map-heading span {
    color: #bdbdbd;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .listing-location,
body.dark-mode .listing-category {
    color: #bdbdbd;
}

body.dark-mode .listing-category {
    border-color: #666;
}

.listing-card img {
    width: 100%;
    height: 20rem;
    object-fit: cover;
    border-radius: 1rem 1rem 0 0;
}

.card-body {
    padding: 0.85rem 0.75rem 1rem;
}

.listing-card .card-body {
    border-radius: 0 0 1rem 1rem;
    background-color: #fff;
}

.listing-card .card-text {
    line-height: 1.5;
}

.listing-card .card-text b {
    display: inline-block;
    margin-bottom: 0.15rem;
}

.card-text {
    margin: 0;
    font-size: 0.95rem;
}

body.dark-mode {
    background-color: #121212;
    color: #f1f1f1;
}

body.dark-mode .auth-page {
    background: transparent;
}

body.dark-mode .auth-card {
    background: #2a2a2c;
    border-color: #444;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .info-card {
    background: #2a2a2c;
    border-color: #444;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 25%);
}

body.dark-mode .info-hero > p:last-child,
body.dark-mode .info-card p {
    color: #bdbdbd;
}

body.dark-mode .info-icon {
    background: rgb(254 66 77 / 18%);
}

body.dark-mode .faq-list details {
    border-color: #444;
}

body.dark-mode .faq-list summary {
    color: #f1f1f1;
}

body.dark-mode .auth-heading p,
body.dark-mode .auth-switch {
    color: #bdbdbd;
}

body.dark-mode .auth-story {
