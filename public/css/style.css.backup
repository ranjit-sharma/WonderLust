}

body.dark-mode .auth-form .form-control:focus {
    background-color: #2a303b !important;
    border-color: #f1f3f5;
    color: #fff;
    box-shadow: none;
}

body.dark-mode .auth-submit,
body.dark-mode .auth-submit:hover,
body.dark-mode .auth-submit:focus {
    background-color: #fe424d !important;
    border-color: #fe424d !important;
    color: #fff !important;
    box-shadow: none;
}

body.dark-mode .navbar,
body.dark-mode .card,
body.dark-mode .modal-content {
    background-color: #2a2a2c !important;
    color: #f1f1f1;
}

body.dark-mode .host-menu {
