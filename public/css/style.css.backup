    color: #ff7880;
}

body.dark-mode .account-dropdown {
    background-color: #2a2a2c;
}

body.dark-mode .account-dropdown .dropdown-item {
    color: #f1f1f1;
}

body.dark-mode .account-dropdown .dropdown-item:hover,
body.dark-mode .account-dropdown .dropdown-item:focus {
