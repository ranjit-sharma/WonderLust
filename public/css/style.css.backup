}

body.dark-mode .btn-outline-secondary {
    color: #d6d6d6;
    border-color: #777;
}

body.dark-mode .btn-outline-danger {
    color: #ff7880;
    border-color: #ff7880;
}

body.dark-mode .btn-outline-danger:hover {
    background-color: #fe424d;
    color: #fff;
}

body.dark-mode .theme-toggle {
    color: #f1f1f1;
    border-color: #f1f1f1;
}

body.dark-mode .menu-dropdown .theme-menu-toggle {
    color: #f1f1f1;
}

body.dark-mode .listing-filters {
    background-color: #2a2a2c;
    border-color: #444;
}

body.dark-mode .filter-panel-header {
    border-color: #333;
    color: #f1f3f5;
}

body.dark-mode .filter-panel-title i {
    color: #ff7880;
}

body.dark-mode .filter-close {
    color: #f1f1f1;
}

body.dark-mode .filter-close:hover {
    background-color: #3a3a3c;
    color: #ff7880;
}

body.dark-mode .filter-label {
    color: #c9d1da;
}

body.dark-mode .filter-label i {
    color: #ff7880;
}

body.dark-mode .filter-input {
    background-color: #323234 !important;
    border-color: #48484a !important;
    color: #f1f3f5 !important;
}

body.dark-mode .filter-input::placeholder {
    color: #7a8894 !important;
}

body.dark-mode .filter-input:focus {
    border-color: #f1f3f5 !important; box-shadow: none !important;
    background-color: #242426 !important;
}

body.dark-mode #price-range-label {
    background: #323234;
    border-color: #48484a;
    color: #f1f3f5;
}

body.dark-mode .price-slider-track {
    background: #48484a;
}

body.dark-mode .price-slider-range {
    background: #fe424d;
}

body.dark-mode .price-slider::-webkit-slider-thumb {
    background: #fe424d;
    border-color: #2a2a2c;
}

body.dark-mode .price-slider::-moz-range-thumb {
    background: #fe424d;
    border-color: #2a2a2c;
}

body.dark-mode .filter-panel-actions {
    border-top-color: #333;
}

body.dark-mode .filter-clear-btn {
    color: #9ca7b0;
}

body.dark-mode .filter-clear-btn:hover {
    color: #f1f3f5;
}

body.dark-mode .filter-apply-btn {
    background-color: #fe424d;
}

body.dark-mode .filter-apply-btn:hover {
    background-color: #e63b46;
}

body.dark-mode .mapboxgl-popup-content {
    background-color: #2a2a2c !important;
    color: #f1f1f1 !important;
}

body.dark-mode .mapboxgl-popup-content h5,
body.dark-mode .mapboxgl-popup-content p {
    color: #f1f1f1 !important;
}

body.dark-mode .mapboxgl-popup-close-button {
    color: #f1f1f1 !important;
}

body.dark-mode .mapboxgl-popup-tip {
    border-top-color: #2a2a2c;
    border-bottom-color: #2a2a2c;
}

body.dark-mode .filter {
    color: #f1f1f1;
}

body.dark-mode .filter.active,
body.dark-mode .filter.active i,
body.dark-mode .filter.active p {
    color: #fe424d;
    opacity: 1;
}

body.dark-mode .text-toggle {
    border-color: #f1f1f1;
}

body.dark-mode .text-toggle .form-check-input {
    background-color: #3a3a3c;
    border-color: #fe424d;
}

body.dark-mode .text-toggle .form-check-input:checked {
    background-color: #fe424d;
    border-color: #fe424d;
}

/* Dark mode — mobile filter toggler */
body.dark-mode .filter-toggler-btn {
    background: #2a2a2c;
    border-color: #48484a;
    color: #f1f3f5;
    box-shadow: 0 1px 4px rgb(0 0 0 / 25%);
}

body.dark-mode .filter-toggler-btn:hover,
body.dark-mode .filter-toggler-btn[aria-expanded="true"] {
    border-color: #fe424d;
    color: #ff7880;
}

body.dark-mode .filter-toggler-chevron {
    color: #7a8894;
}

/* Dark mode — category filter toggle */
body.dark-mode .category-filter-toggle {
    background-color: #2a2a2c;
    border-color: #48484a;
    color: #c9d1da;
    box-shadow: none;
}

body.dark-mode .category-filter-toggle i {
    color: #ff7880;
}

body.dark-mode .category-filter-toggle:hover,
body.dark-mode .category-filter-toggle:focus {
    background-color: #4a1a1d;
    border-color: #fe424d;
    color: #ff7880;
    box-shadow: 0 2px 8px rgb(254 66 77 / 20%);
}

body.dark-mode .f-info {
    background-color: #2a2a2c !important;
    color: #f1f1f1;
}

body.dark-mode .f-info-links a {
    color: #f1f1f1;
}

body.dark-mode hr {
    border-color: #666;
    opacity: 1;
}

body.dark-mode .text-muted {
    color: #aaa !important;
}

/* Flash Toast Messages */
.flash-toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 18rem;
    max-width: 26rem;
    padding: 1rem 1.1rem;
    border-radius: 0.85rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 15%);
    font-size: 0.92rem;
    font-weight: 500;
    animation: flash-slide-up 0.35s ease forwards;
}

@keyframes flash-slide-up {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: translateY(0); }
}

.flash-success {
    background-color: #f0faf4;
    border-left: 4px solid #22c55e;
    color: #166534;
}

.flash-error {
    background-color: #fff1f2;
    border-left: 4px solid #fe424d;
    color: #9f1239;
}

.flash-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
}

.flash-success .flash-icon { color: #22c55e; }
.flash-error   .flash-icon { color: #fe424d; }

.flash-msg {
    flex: 1;
    line-height: 1.4;
}

.flash-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    opacity: 0.5;
    color: inherit;
    flex-shrink: 0;
}

.flash-close:hover { opacity: 1; }

/* Dark mode */
body.dark-mode .flash-success {
    background-color: #1a3d26;
    border-left-color: #22c55e;
    color: #86efac;
}

body.dark-mode .flash-error {
    background-color: #4a1a1d;
    border-left-color: #fe424d;
    color: #fda4af;
}

body.dark-mode .btn-close {
    filter: invert(1) grayscale(100%) brightness(200%);
}

body.dark-mode .wishlist-btn {
    background-color: #3a3a3c;
    color: #ff7880;
    border: 1px solid #555;
}

.listing-card-link {
    color: inherit;
    text-decoration: none;
}

.wishlist-form {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 2;
}

.index-listing-card .wishlist-form {
    position: static;
    display: flex;
    width: fit-content;
}

.wishlist-btn {
    border: none;
    background: #fff;
    color: #fe424d;
    border-radius: 50%;
    width: 2.2rem;
    height: 2.2rem;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 1px 5px rgb(0 0 0 / 20%);
}

.index-listing-card .wishlist-btn {
    width: 2rem;
    height: 2rem;
    font-size: 1.35rem;
    box-shadow: 0 1px 4px rgb(0 0 0 / 14%);
}

.profile-stat,
.profile-section {
    border: 1px solid #e5e5e5;
    border-radius: 1rem;
    padding: 1.2rem;
    background: #fff;
}

.profile-stat {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.profile-stat-icon {
    color: #fe424d;
    font-size: 1.35rem;
}

.profile-stat strong,
.profile-stat span {
    display: block;
}

.profile-stat strong {
    font-size: 1.5rem;
}

.profile-stat span:last-child {
    color: #6c757d;
    font-size: 0.9rem;
}

.profile-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}

.profile-section-heading h4,
.profile-section > h4 {
    margin: 0;
}

.profile-list {
    border-top: 1px solid #e5e5e5;
}

.profile-list-item,
.profile-review {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e5e5e5;
    color: inherit;
    text-decoration: none;
}

.profile-review {
    align-items: flex-start;
}

.profile-booking {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e5e5e5;
}

.profile-booking a {
    color: inherit;
}

.profile-booking-status {
    display: inline-block;
    color: #198754;
    font-size: 0.8rem;
    text-transform: capitalize;
}

.profile-booking-status.cancelled {
    color: #6c757d;
}

.booking-action-btn {
    min-width: 4.75rem;
    border-radius: 0.45rem;
}

.profile-review a {
    color: inherit;
}

.profile-rating {
    color: #fe424d;
    font-weight: 600;
    white-space: nowrap;
}

.profile-heart {
    color: #fe424d;
}

.profile-settings {
    margin-top: 1rem;
    border-top: 1px solid #e5e5e5;
}

.profile-settings p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.8rem 0;
    border-bottom: 1px solid #e5e5e5;
}

.profile-settings p span {
    color: #6c757d;
}

.booking-card,
.booking-confirmation {
    border: 1px solid #e5e5e5;
    border-radius: 1rem;
    padding: 1.25rem;
    background: #fff;
}

.booking-nightly-price {
    color: #6c757d;
}

.booking-price-breakdown p,
.booking-summary p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
}

.booking-total {
    font-size: 1.1rem;
    font-weight: 700;
}

.booking-confirmation {
    max-width: 40rem;
    margin: 3rem auto;
    text-align: center;
}

.booking-confirmation-icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e8f7ee;
    color: #198754;
}

.booking-summary {
    margin: 1.5rem 0;
    padding: 1rem;
    text-align: left;
    border-radius: 0.75rem;
    background: #f8f9fa;
}

body.dark-mode .booking-card,
body.dark-mode .booking-confirmation {
    background: #2a2a2c;
    border-color: #444;
}

body.dark-mode .booking-summary {
    background: #3a3a3c;
}

body.dark-mode .booking-confirmation-icon {
    background: #1e4d34;
}

body.dark-mode .profile-stat,
body.dark-mode .profile-section {
    background: #2a2a2c;
    border-color: #444;
}

body.dark-mode .profile-list,
body.dark-mode .profile-list-item,
body.dark-mode .profile-review,
body.dark-mode .profile-booking,
body.dark-mode .profile-settings,
body.dark-mode .profile-settings p {
    border-color: #444;
}

/* ================= TABLET ================= */

@media (max-width: 992px) {

    .f-info {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
        grid-template-columns: minmax(15rem, 1fr) minmax(20rem, 1.4fr) minmax(10rem, 0.8fr);
        gap: 1.25rem;
    }

    #filters {
        gap: 1.3rem;
        justify-content: center;
    }

    .search-nav {
        flex: 1 1 auto;
    }

    .navbar .search-form {
        max-width: 20rem;
    }

    .text-toggle {
        margin-left: 0;
    }

    .filter-controls {
        margin-left: 0;
        margin-top: 0.5rem;
    }

    .listing-card img {
        height: 18rem;
    }

    .listing-filters {
        right: 1rem;
    }
}

/* ================= MOBILE ================= */

@media (max-width: 767px) {

    .navbar {
        height: auto;
        padding: 0.65rem 0.85rem;
    }

    .auth-page {
        min-height: 30rem;
        padding: 2rem 0.75rem;
    }

    .auth-card {
        padding: 2rem 1.25rem;
    }

    .navbar-brand span {
        font-size: 1rem;
    }

    .primary-nav {
        margin-left: 0;
    }

    .navbar-collapse {
        width: 100%;
    }

    .navbar-collapse .navbar-nav {
        width: 100%;
    }

    .navbar-collapse .search-nav {
        display: block;
        margin: 0.5rem 0 !important;
    }

    .search-nav {
        width: 100%;
    }

    .navbar .search-form {
        width: 100%;
        max-width: none;
        gap: 0;
        flex-wrap: nowrap;
    }

    .navbar-actions {
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .account-dropdown,
    .menu-dropdown {
        width: min(20.75rem, calc(100vw - 2rem));
    }

    .search-form .search-inp {
        width: 0;
        margin-right: 0 !important;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }

    .search-form .search-btn {
        padding: 0;
    }

    .navbar-collapse > .navbar-nav:last-child {
        padding-bottom: 0.5rem;
    }

    /* Show toggler */
    .filter-toggler {
        display: block;
    }

    .listing-filters {
        top: 5.5rem;
        right: 1rem;
        width: calc(100% - 2rem);
        max-height: calc(100vh - 6.5rem);
    }

    /* Filter menu becomes block */
    #filters {
        display: flex !important;
        flex-direction: column;
        align-items: stretch;
        padding: 1rem 0;
        gap: 1rem;
    }

    /* Categories become grid on mobile inside collapse */
    .categories-scroll-wrapper {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem 0.5rem;
    }

    /* Hide filters when collapse is closed */
    #filters:not(.show) {
        display: none !important;
    }

    .filter {
        min-width: auto;
    }

    .category-filter-toggle {
        display: none; /* Hide the extra 'Filters' button on mobile since we have the main toggler */
    }

    .filter i {
        font-size: 1.1rem;
    }

    .filter p {
        font-size: 0.75rem;
    }

    /* Tax switch */
    .text-toggle {
        margin: 0;
        text-align: center;
        white-space: normal;
        width: 100%;
    }

    .filter-controls {
        align-items: stretch;
        flex-direction: column;
        width: 100%;
        margin-top: 0;
    }

    .filter-controls .text-toggle,
    .filter-controls .filter-toggle {
        width: 100%;
        text-align: center;
    }

    /* Listing */
    .listing-card {
        margin-bottom: 1.5rem;
    }

    .listing-card img {
        height: 13rem !important;
        border-radius: 0.8rem 0.8rem 0 0;
    }

    .listing-card.index-listing-card {
        padding: 0.6rem;
    }

    .listing-card.index-listing-card .card-img-top {
        height: 13rem !important;
        border-radius: 0.75rem !important;
    }

    .card-text {
        font-size: 0.9rem;
    }

    .f-info {
        grid-template-areas:
            "center"
            "support"
            "right"
            "meta";
        grid-template-columns: 1fr;
        gap: 0.7rem;
        padding: 0.8rem 0.75rem 0.6rem;
    }

    .f-info-support {
        width: 100%;
        padding-bottom: 0;
        text-align: center;
    }

    .f-info-support-links {
        grid-template-columns: 1fr;
        gap: 0.3rem;
    }

    .f-info-support-links a {
        white-space: normal;
    }

    .f-info-center,
    .f-info-right {
        width: 100%;
    }

    .f-info-center {
        text-align: center;
    }

    .f-info-center .f-info-brand,
    .f-info-center .f-info-socials,
    .f-info-center .f-info-tagline {
        justify-content: center;
        text-align: center;
    }

    .f-info-right {
        text-align: center;
    }

    .f-info-right .f-info-links {
        align-items: center;
    }

    .show-content-section {
        width: 100%;
        margin-left: 0;
    }

    .reviews-section {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .show-main-layout {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .show-map-panel {
        position: static;
    }

    .show-map-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.2rem;
    }

    .show-map-heading span {
        text-align: left;
    }

    #map {
        height: 21rem;
    }

    .reviews-section {
        grid-template-columns: 1fr;
    }

    .booking-card-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.35rem;
    }

    .wishlist-page {
        padding: 2rem 0 3rem;
    }

    .wishlist-heading {
        align-items: flex-start;
        flex-direction: column;
        margin-bottom: 1.5rem;
    }

    .wishlist-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .info-page {
        padding: 2.5rem 0.75rem 3rem;
    }

    .info-card {
        padding: 1.35rem;
    }

    .info-grid,
    .info-story {
        grid-template-columns: 1fr;
    }

    .support-form-grid {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .support-form .info-primary-btn {
        width: 100%;
    }

    .info-story {
        gap: 0.75rem;
    }

    .info-primary-btn {
        grid-column: auto;
    }
}

@media (max-width: 575px) {
    .wishlist-grid {
        grid-template-columns: 1fr;
    }

    .wishlist-card-body {
        padding: 0.9rem;
    }
}


/* ================= SMALL PHONES ================= */

@media (max-width: 400px) {

    .categories-scroll-wrapper {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem 0.3rem;
    }

    .filter p {
        font-size: 0.7rem;
    }

    .filter i {
        font-size: 1rem;
    }

    .listing-card img {
        height: 13rem !important;
    }
}

/* ================= LIGHT MODE SURFACES ================= */

body:not(.dark-mode) {
    background-color: #f5f6f8;
}

body:not(.dark-mode) .navbar {
    background-color: #ffffff;
    border-bottom-color: #e2e4e8 !important;
}

body:not(.dark-mode) .container {
    background-color: transparent;
}

body:not(.dark-mode) .card,
body:not(.dark-mode) .booking-card,
body:not(.dark-mode) .booking-confirmation,
body:not(.dark-mode) .profile-stat,
body:not(.dark-mode) .profile-section {
    border-color: #e1e3e8;
    box-shadow: 0 0.35rem 1rem rgb(35 42 52 / 7%);
}

body:not(.dark-mode) .listing-card .card-body {
    background-color: #ffffff;
}

body:not(.dark-mode) .listing-card {
    background-color: transparent;
}

body:not(.dark-mode) .index-listing-card {
    background-color: #fff;
}

body:not(.dark-mode) .listing-filters {
    border-color: #d9dce2;
    box-shadow: 0 0.75rem 2rem rgb(35 42 52 / 16%);
}

body:not(.dark-mode) .text-toggle {
    background-color: #ffffff;
    border-color: #cfd3da;
}

body:not(.dark-mode) .category-filter-toggle {
    box-shadow: 0 0.15rem 0.4rem rgb(35 42 52 / 10%);
}

body:not(.dark-mode) .form-control,
body:not(.dark-mode) .form-select {
    background-color: #ffffff;
    border-color: #cfd3da;
}

body:not(.dark-mode) .booking-summary {
    background-color: #eef1f5;
    border: 1px solid #e0e3e8;
}

body:not(.dark-mode) .review-card {
    background-color: #ffffff;
    border-color: #dfe2e7;
    box-shadow: 0 0.25rem 0.75rem rgb(35 42 52 / 6%);
}

.review-card {
    overflow: hidden;
    border: 1px solid #e1e5ea;
    border-radius: 0.9rem;
    background: #ffffff;
    box-shadow: 0 0.35rem 1rem rgb(35 42 52 / 7%);
}

.review-card .card-body {
    display: flex;
    flex-direction: column;
    padding: 0.95rem 1.1rem;
}

.review-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}

.review-author {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
}

.review-avatar {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 2.1rem;
    place-items: center;
    border-radius: 50%;
    background: #fff0f1;
    color: #d93644;
    font-size: 1rem;
    font-weight: 700;
}

.review-author-name {
    overflow: hidden;
    margin: 0;
    color: #212529;
    font-size: 1rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.review-label {
    color: #7b8490;
    font-size: 0.75rem;
}

.review-rating {
    flex: 0 0 auto;
    color: #6c757d;
    font-size: 0.78rem;
    font-weight: 600;
}

.review-stars {
    display: flex;
    align-items: center;
    min-height: 1.8rem;
    margin: 0.55rem 0 0.25rem;
}

.review-stars .starability-result {
    transform: scale(0.78);
    transform-origin: left center;
}

.review-comment {
    margin: 0;
    color: #4d5661;
    font-size: 0.95rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
}

.review-actions {
    margin-top: auto;
    padding-top: 0.7rem;
}

.review-actions .btn {
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
}

body.dark-mode .review-card {
    border-color: #5a5a5a;
    background: #28282a;
    box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 22%);
}

body.dark-mode .review-author-name {
    color: #f1f3f5;
}

body.dark-mode .review-label,
body.dark-mode .review-rating {
    color: #adb5bd;
}

body.dark-mode .review-comment {
    color: #d5d9de;
}

body.dark-mode .review-avatar {
    background: #5a3338;
    color: #ff8790;
}

/* Material-inspired application surfaces. Navbar styling remains unchanged. */
:root {
    --material-primary: #fe424d;
    --material-primary-dark: #d93644;
    --material-surface: #ffffff;
    --material-background: #f5f6f8;
    --material-border: #e1e5ea;
    --material-text: #263238;
    --material-muted: #68737d;
    --material-radius: 0.75rem;
    --material-radius-lg: 1rem;
    --material-shadow: 0 0.35rem 1rem rgb(38 50 56 / 10%);
    --material-shadow-raised: 0 0.7rem 1.6rem rgb(38 50 56 / 14%);
}

body:not(.dark-mode) {
    background: var(--material-background);
    color: var(--material-text);
}

body:not(.dark-mode) .container {
    background: transparent;
}

body:not(.dark-mode) main.container {
    padding-top: 1rem;
    padding-bottom: 2rem;
}

body:not(.dark-mode) h1,
body:not(.dark-mode) h2,
body:not(.dark-mode) h3,
body:not(.dark-mode) h4,
body:not(.dark-mode) h5,
body:not(.dark-mode) h6 {
    color: var(--material-text);
    letter-spacing: -0.02em;
}

/* Shared Material-style controls */
.form-control:not(.navbar *),
.form-select:not(.navbar *) {
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
}

.form-control:not(.navbar *),
.form-select:not(.navbar *) {
    min-height: 2.75rem;
    border: 1px solid var(--material-border);
    border-radius: var(--material-radius);
    background-color: var(--material-surface);
    color: var(--material-text);
}

.form-control:not(.navbar *):focus,
.form-select:not(.navbar *):focus {
    border-color: #222; box-shadow: none;
}

.form-label:not(.navbar *) {
    color: var(--material-text);
    font-size: 0.82rem;
    font-weight: 600;
}

/* Main content cards and panels */
body:not(.dark-mode) .card:not(.navbar *),
body:not(.dark-mode) .booking-card,
body:not(.dark-mode) .booking-confirmation,
body:not(.dark-mode) .profile-section,
body:not(.dark-mode) .profile-stat,
body:not(.dark-mode) .auth-card,
body:not(.dark-mode) .support-card,
body:not(.dark-mode) .info-page,
body:not(.dark-mode) .show-map-panel {
    border-color: var(--material-border);
    border-radius: var(--material-radius-lg);
    box-shadow: var(--material-shadow);
}

.auth-card,
.support-card,
.info-page,
.profile-section,
.booking-card,
.booking-confirmation {
    border-radius: var(--material-radius-lg);
}

.auth-card,
.support-card,
.booking-card,
.booking-confirmation {
    padding: 1.5rem;
}

.auth-icon {
    background: #fff0f1;
    color: var(--material-primary);
}

/* Listing cards */
.index-listing-card,
.wishlist-card {
    border-color: var(--material-border) !important;
    border-radius: var(--material-radius-lg);
    box-shadow: var(--material-shadow);
}

.index-listing-card:hover,
.wishlist-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--material-shadow-raised);
}

.index-listing-card .card-img-top,
.wishlist-image {
    border-radius: 0.7rem !important;
}

.listing-title-row .listing-card-link,
.wishlist-card-body h2 {
    color: var(--material-text);
}

.listing-location,
.listing-category,
.wishlist-location,
.average-rating {
    color: var(--material-muted);
}

/* Filters and booking details */
.listing-filters,
.filter-bar,
.booking-price-breakdown,
.booking-summary {
    border-radius: var(--material-radius);
    box-shadow: var(--material-shadow);
}

.listing-filters {
    border: 1px solid var(--material-border);
    background: var(--material-surface);
}

.booking-card-heading {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #edf0f2;
}

.booking-card-heading h4 {
    font-weight: 700;
}

/* Show page, reviews, and map */
.show-card,
.show-map-panel,
.review-card {
    border-color: var(--material-border) !important;
    box-shadow: var(--material-shadow);
}

.show-card,
.show-map-panel {
    border-radius: var(--material-radius-lg);
}

.review-card {
    border-radius: var(--material-radius);
}

.review-card:hover {
    transform: none;
    box-shadow: var(--material-shadow);
}

.show-title {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
}

.reviews-heading {
    color: var(--material-text);
    font-size: 1.1rem;
}

/* Feedback, support, and informational pages */
.support-form,
.feedback-form,
.info-page {
    color: var(--material-text);
}

.support-form textarea,
.feedback-form textarea {
    min-height: 8rem;
}

/* Material-style dark surfaces */
body.dark-mode {
    background: #1c1c1e;
    color: #edf1f4;
}

body.dark-mode main.container {
    background: transparent;
}

body.dark-mode .card:not(.navbar *),
body.dark-mode .booking-card,
body.dark-mode .booking-confirmation,
body.dark-mode .profile-section,
body.dark-mode .profile-stat,
body.dark-mode .auth-card,
body.dark-mode .support-card,
body.dark-mode .info-page,
body.dark-mode .show-card,
body.dark-mode .show-map-panel,
body.dark-mode .review-card {
    border-color: #48484a !important;
    background: #242426;
    box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 24%);
}

body.dark-mode h1,
body.dark-mode h2,
body.dark-mode h3,
body.dark-mode h4,
body.dark-mode h5,
body.dark-mode h6,
body.dark-mode .form-label,
body.dark-mode .reviews-heading {
    color: #f1f3f5;
}

body.dark-mode .form-control:not(.navbar *),
body.dark-mode .form-select:not(.navbar *) {
    border-color: #58585a;
    background-color: #2c2c2e;
    color: #f1f3f5;
}

body.dark-mode .form-control:not(.navbar *)::placeholder {
    color: #9ca7b0;
}

body.dark-mode .booking-card-heading,
body.dark-mode .show-map-heading {
    border-color: #48484a;
}

body.dark-mode .listing-filters {
    border-color: #48484a;
    background: #242426;
}

@media (max-width: 767px) {
    body:not(.dark-mode) main.container {
        padding-top: 0.5rem;
    }

    .auth-card,
    .support-card,
    .booking-card,
    .booking-confirmation {
        padding: 1.15rem;
    }

    .show-title {
        margin-top: 0.25rem;
    }
}

body:not(.dark-mode) .f-info {
    background-color: #e9ebef;
    border-top-color: #d9dce2;
}

/* Reference-style footer layout */
.f-info {
    grid-template-areas:
        "column-one column-two column-three"
        "meta meta meta";
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 2rem;
    width: 100%;
    margin: 0 auto;
    padding: 1rem 3rem 0.55rem;
    background-color: #f7f7f7;
    color: #222;
}

.f-info-column {
    min-width: 0;
}

.f-info-column:nth-child(1) {
    grid-area: column-one;
}

.f-info-column:nth-child(2) {
    grid-area: column-two;
}

.f-info-column:nth-child(3) {
    grid-area: column-three;
}

.f-info-column h3 {
    margin: 0 0 0.5rem;
    color: #222;
    font-size: 0.98rem;
    font-weight: 600;
}

.f-info-column .f-info-brand {
    justify-content: flex-start;
    color: #fe424d !important;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.f-info-column .f-info-brand i {
    color: #fe424d !important;
    font-size: 1.2rem;
}

.f-info-column .f-info-tagline {
    justify-content: flex-start;
    margin-top: 0.2rem;
    color: #222;
    font-size: 0.84rem;
    text-align: left;
}

.f-info-description {
    max-width: 21rem;
    margin: 0.4rem 0 0;
    color: #222;
    font-size: 0.8rem;
    line-height: 1.55;
}

.f-info-description strong {
    display: block;
    margin-bottom: 0.4rem;
}

.f-info-note {
    margin-top: 0.3rem;
}

.f-info-column-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem 1.2rem;
}

.f-info-column:nth-child(2) .f-info-column-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    column-gap: 1.4rem;
}

.f-info-column-links a,
.f-info-legal a {
    color: #222;
    font-size: 0.84rem;
    line-height: 1.25;
    text-decoration: none;
}

.f-info-column-links a:hover,
.f-info-legal a:hover {
    color: #fe424d;
    text-decoration: underline;
    text-underline-offset: 0.15rem;
}

.f-info-meta {
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-top: 0.55rem;
    border-top: 1px solid #e5e5e5;
    color: #222;
    font-size: 0.78rem;
}

.f-info-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1rem;
}

.f-info-legal span,
.f-info-legal a {
    color: #222;
}

.f-info-legal span + a,
.f-info-legal a + a,
.f-info-legal a + span {
    margin-left: 0.35rem;
}

.f-info-socials {
    justify-content: flex-end;
    gap: 0.4rem;
}

.f-info-socials a {
    margin: 0;
    color: #222;
}

.f-info-socials i {
    font-size: 0.88rem;
}

body.dark-mode .f-info {
    background-color: #2a2a2c;
    color: #f1f1f1;
}

body.dark-mode .f-info-column h3,
body.dark-mode .f-info-column-links a,
body.dark-mode .f-info-legal span,
body.dark-mode .f-info-legal a,
body.dark-mode .f-info-socials a,
body.dark-mode .f-info-column .f-info-tagline,
body.dark-mode .f-info-description {
    color: #f1f1f1;
}

body.dark-mode .f-info-column .f-info-brand,
body.dark-mode .f-info-column .f-info-brand i {
    color: #fe424d !important;
}

body.dark-mode .f-info-meta {
    border-top-color: #444;
}

@media (max-width: 768px) {
    .f-info {
        grid-template-areas:
            "column-one"
            "column-two"
            "column-three"
            "meta";
        grid-template-columns: 1fr;
        gap: 0.8rem;
        padding: 0.9rem 1rem 0.55rem;
    }

    .f-info-column,
    .f-info-column-links {
        align-items: center;
        text-align: center;
    }

    .f-info-column:nth-child(2) .f-info-column-links {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .f-info-column .f-info-brand,
    .f-info-column .f-info-tagline,
    .f-info-description {
        justify-content: center;
        text-align: center;
    }

    .f-info-column h3 {
        margin-bottom: 0.65rem;
    }

    .f-info-column-links {
        gap: 0.45rem;
    }

    .f-info-meta {
        flex-direction: column;
        gap: 0.8rem;
        padding-top: 0.8rem;
    }

    .f-info-legal {
        justify-content: center;
        text-align: center;
    }

    .f-info-socials {
        justify-content: center;
    }
}

/* Four-column footer arrangement */
.f-info {
    grid-template-areas:
        "brand support explore connected"
        "meta meta meta meta";
    grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
    gap: 1rem 2rem;
}

.f-info-column:nth-child(1) {
    grid-area: brand;
}

.f-info-column:nth-child(2) {
    grid-area: support;
}

.f-info-column:nth-child(3) {
    grid-area: explore;
}

.f-info-column:nth-child(4) {
    grid-area: connected;
}

.f-info-column:nth-child(2) .f-info-column-links {
    display: flex;
}

.f-info-connected > p {
    margin: 0 0 0.45rem;
    color: #222;
    font-size: 0.84rem;
}

.f-info-subscribe {
    display: flex;
    max-width: 14rem;
    margin-bottom: 0.65rem;
}

.f-info-subscribe input {
    min-width: 0;
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 1px solid #cfd3da;
    border-radius: 0.35rem 0 0 0.35rem;
    color: #222;
    font: inherit;
    font-size: 0.8rem;
}

.f-info-subscribe button {
    border: 0;
    border-radius: 0 0.35rem 0.35rem 0;
    background: #fe424d;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    padding: 0.35rem 0.55rem;
    white-space: nowrap;
}

.f-info-connected .f-info-socials {
    justify-content: flex-start;
}

body.dark-mode .f-info-connected > p {
    color: #f1f1f1;
}

body.dark-mode .f-info-subscribe input {
    background: #3a3a3c;
    border-color: #666;
    color: #f1f1f1;
}

@media (max-width: 768px) {
    .f-info {
        grid-template-areas:
            "brand"
            "support"
            "explore"
            "connected"
            "meta";
        grid-template-columns: 1fr;
    }

    .f-info-subscribe {
        margin-left: auto;
        margin-right: auto;
    }

    .f-info-connected .f-info-socials {
        justify-content: center;
    }
}

/* Make footer border lines darker */
body:not(.dark-mode) .f-info {
    border-top: none !important;
}
body:not(.dark-mode) .f-info-meta {
    border-top: 1px solid #a0a0a0 !important;
}